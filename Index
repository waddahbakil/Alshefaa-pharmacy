function openSettingsModal(){
    const cfg = JSON.parse(localStorage.getItem('shifa_firebase_config')||'{}');
    document.getElementById('cfg_apiKey').value = cfg.apiKey||firebaseConfig.apiKey||'';
    document.getElementById('cfg_authDomain').value = cfg.authDomain||firebaseConfig.authDomain||'';
    document.getElementById('cfg_databaseURL').value = cfg.databaseURL||firebaseConfig.databaseURL||'';
    document.getElementById('cfg_projectId').value = cfg.projectId||firebaseConfig.projectId||'';
    document.getElementById('cfg_storageBucket').value = cfg.storageBucket||firebaseConfig.storageBucket||'';
    document.getElementById('cfg_messagingSenderId').value = cfg.messagingSenderId||firebaseConfig.messagingSenderId||'';
    document.getElementById('cfg_appId').value = cfg.appId||firebaseConfig.appId||'';
    document.getElementById('firebaseConfigInput').value = localStorage.getItem('shifa_firebase_config')||'';
    document.getElementById('settingsModal').classList.add('active');
}
function closeSettingsModal(){ document.getElementById('settingsModal').classList.remove('active'); }
function saveFirebaseConfig(){
    let cfg = {};
    try{
        const txt = document.getElementById('firebaseConfigInput').value.trim();
        if(txt){
            cfg = JSON.parse(txt);
        } else {
            cfg = {
                apiKey: document.getElementById('cfg_apiKey').value.trim(),
                authDomain: document.getElementById('cfg_authDomain').value.trim(),
                databaseURL: document.getElementById('cfg_databaseURL').value.trim(),
                projectId: document.getElementById('cfg_projectId').value.trim(),
                storageBucket: document.getElementById('cfg_storageBucket').value.trim(),
                messagingSenderId: document.getElementById('cfg_messagingSenderId').value.trim(),
                appId: document.getElementById('cfg_appId').value.trim()
            };
        }
        if(!cfg.apiKey){ alert('apiKey مطلوب'); return; }
        localStorage.setItem('shifa_firebase_config', JSON.stringify(cfg));
        Object.assign(firebaseConfig, cfg);
        document.getElementById('settingsMsg').style.color='green';
        document.getElementById('settingsMsg').textContent='✅ تم حفظ إعدادات Firebase';
        initFirebase();
        showToast('✅ تم حفظ إعدادات Firebase');
        setTimeout(closeSettingsModal, 1000);
    }catch(e){
        document.getElementById('settingsMsg').style.color='red';
        document.getElementById('settingsMsg').textContent='❌ خطأ: ' + e.message;
    }
}
function testFirebaseConfig(){
    saveFirebaseConfig();
    setTimeout(async ()=>{
        try{
            if(!isFirebaseConfigured) initFirebase();
            if(firebaseDB){
                await firebaseDB.ref('test').set({time: new Date().toISOString()});
                document.getElementById('settingsMsg').style.color='green';
                document.getElementById('settingsMsg').textContent='✅ الاتصال ناجح مع Firebase!';
            }
        }catch(e){
            document.getElementById('settingsMsg').style.color='red';
            document.getElementById('settingsMsg').textContent='❌ فشل الاتصال: ' + e.message;
        }
    },500);
}

