input[type="number"], input[type="text"] { padding: 5px; border-radius: 5px; border: 1px solid rgb(204, 204, 204); width: 70px; text-align: center; font-size: 12px; }

button { background: rgb(43, 140, 94); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 6px 10px; border-radius: 5px; cursor: pointer; margin: 1px; font-size: 11px; touch-action: manipulation; }

.btn-wa { background: rgb(37, 211, 102); }

.btn-sms { background: rgb(33, 150, 243); }

.btn-danger { background: rgb(220, 53, 69); }

.btn-save-cloud { background: rgb(23, 162, 184); }

.btn-send-all { background: rgb(255, 152, 0); }

.button-group { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }

.button-group button { flex: 1 1 0%; font-size: 13px; padding: 10px; }

.footer { text-align: center; color: white; margin-top: 15px; font-size: 11px; opacity: 0.8; }

.empty { text-align: center; padding: 30px; color: rgb(153, 153, 153); }

.movement-row { background: rgb(232, 245, 233) !important; }

.import-section { border: 2px dashed rgb(43, 140, 94); border-radius: 8px; padding: 12px; margin-bottom: 12px; background: rgb(250, 250, 250); text-align: center; }

.import-section p { font-size: 11px; color: rgb(102, 102, 102); margin: 4px 0px 8px; }

.import-section input[type="file"] { margin-bottom: 8px; display: inline-block; font-size: 12px; width: 100%; }

.btn-import { background: rgb(108, 117, 125); color: white; width: 100%; max-width: 250px; padding: 8px; border-radius: 5px; display: block; margin: 0px auto; }

.touch-btn { min-height: 44px; min-width: 44px; }

.table-scroll { overflow: auto; max-height: 60vh; }

.toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: rgb(51, 51, 51); color: white; padding: 12px 24px; border-radius: 25px; font-size: 14px; z-index: 1000; opacity: 0; transition: opacity 0.3s; pointer-events: none; }

.toast.show { opacity: 1; }

.modal-overlay { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.5); display: none; justify-content: center; align-items: center; z-index: 2000; }

.modal-overlay.active { display: flex; }

.modal { background: white; border-radius: 15px; padding: 20px; max-width: 90%; width: 350px; text-align: center; }

.modal h3 { color: rgb(30, 87, 153); margin-bottom: 15px; }

.modal p { margin-bottom: 15px; font-size: 14px; line-height: 1.6; }

.modal-buttons { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

.modal-buttons button { padding: 10px 20px; font-size: 14px; }

.btn-confirm { background: rgb(43, 140, 94); }

.btn-cancel { background: rgb(108, 117, 125); }

.btn-wa-modal { background: rgb(37, 211, 102); }

.activation-overlay { position: fixed; inset: 0px; background: linear-gradient(135deg, rgb(30, 87, 153) 0%, rgb(43, 140, 94) 100%); display: flex; justify-content: center; align-items: center; z-index: 3000; }

.activation-box { background: white; border-radius: 20px; padding: 30px; max-width: 90%; width: 350px; text-align: center; box-shadow: rgba(0, 0, 0, 0.3) 0px 10px 30px; }

.activation-box h2 { color: rgb(220, 53, 69); margin-bottom: 15px; }

.activation-box p { color: rgb(102, 102, 102); margin-bottom: 20px; font-size: 14px; }

.activation-box input { width: 100%; padding: 12px; margin-bottom: 15px; border: 2px solid rgb(221, 221, 221); border-radius: 10px; font-size: 16px; text-align: center; letter-spacing: 2px; }

.activation-box button { width: 100%; padding: 12px; font-size: 16px; border-radius: 10px; background: rgb(220, 53, 69); }

.activation-error { color: rgb(220, 53, 69); font-size: 14px; margin-top: 10px; display: none; }

.activation-error.show { display: block; }

.trial-info { background: rgb(255, 243, 205); padding: 10px; border-radius: 8px; margin-bottom: 15px; font-size: 13px; color: rgb(133, 100, 4); }

.settings-btn { position: fixed; top: 10px; left: 10px; background: rgba(255, 255, 255, 0.2); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; width: 40px; height: 40px; color: white; font-size: 18px; z-index: 100; cursor: pointer; }

.action-buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; width: 100%; }

.action-buttons button { width: 100%; margin: 0px; padding: 8px 4px; font-size: 11px; min-height: 40px; }

.compact-row td { padding: 4px 2px; vertical-align: middle; }

.compact-row input { padding: 3px; font-size: 11px; }

.send-all-progress { background: rgb(227, 242, 253); padding: 10px; border-radius: 8px; margin-bottom: 12px; text-align: center; font-size: 13px; display: none; }

.send-all-progress.active { display: block; }

.progress-bar { width: 100%; height: 8px; background: rgb(221, 221, 221); border-radius: 4px; margin-top: 8px; overflow: hidden; }

.progress-fill { height: 100%; background: rgb(43, 140, 94); width: 0%; transition: width 0.3s; }

@media (max-width: 700px) {
