.filter-buttons { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }

.filter-buttons button { flex: 1 1 0%; padding: 10px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 13px; touch-action: manipulation; }

.stats { background: rgb(227, 242, 253); padding: 10px; border-radius: 8px; margin-bottom: 12px; text-align: center; font-weight: bold; font-size: 13px; }

