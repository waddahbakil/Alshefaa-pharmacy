// ===== إعدادات Firebase - تم استرجاعها (ضع إعداداتك هنا) =====
// يمكنك الحصول عليها من console.firebase.google.com > Project Settings > General > Your apps > SDK setup
const firebaseConfig = {
    apiKey: "PUT_YOUR_API_KEY_HERE",
    authDomain: "PUT_YOUR_AUTH_DOMAIN_HERE",
    databaseURL: "PUT_YOUR_DATABASE_URL_HERE",
    projectId: "PUT_YOUR_PROJECT_ID_HERE",
    storageBucket: "PUT_YOUR_STORAGE_BUCKET_HERE",
    messagingSenderId: "PUT_YOUR_SENDER_ID_HERE",
    appId: "PUT_YOUR_APP_ID_HERE"
};

let firebaseApp = null;
let firebaseDB = null;
let isFirebaseConfigured = false;

function initFirebase(){
    try{
        if(firebaseConfig.apiKey && firebaseConfig.apiKey !== "PUT_YOUR_API_KEY_HERE"){
            if(!firebase.apps.length){
                firebaseApp = firebase.initializeApp(firebaseConfig);
            } else {
                firebaseApp = firebase.app();
            }
            firebaseDB = firebase.database ? firebase.database() : null;
            if(firebase.firestore){
                window.firestoreDB = firebase.firestore();
            }
            isFirebaseConfigured = true;
            document.getElementById('syncStatus').innerHTML = '☁️ Firebase جاهز - متصل بالسحابة';
            document.getElementById('syncStatus').style.background = '#e3f2fd';
            return true;
        } else {
            isFirebaseConfigured = false;
            document.getElementById('syncStatus').innerHTML = '✅ الحفظ المحلي نشط - Firebase غير مكون (اضغط ⚙️ للإعداد)';
            document.getElementById('syncStatus').style.background = '#e8f5e9';
            return false;
        }
    }catch(e){
        console.error(e);
        isFirebaseConfigured = false;
        document.getElementById('syncStatus').innerHTML = '⚠️ خطأ في Firebase: ' + e.message;
        return false;
    }
}

// استرجاع الإعدادات المحفوظة محلياً
function loadFirebaseConfigFromLocal(){
    const saved = localStorage.getItem('shifa_firebase_config');
    if(saved){
        try{
            const cfg = JSON.parse(saved);
            Object.assign(firebaseConfig, cfg);
        }catch(e){}
    }
}


async function uploadToGoogle(){
    const msgEl = document.getElementById('cloudMsg');
    msgEl.style.color = '#FF9800';
    msgEl.textContent = '⏳ جاري الرفع إلى سيرفر جوجل Firebase...';
    try{
        saveLocal();
        if(!isFirebaseConfigured){
            initFirebase();
        }
        if(!isFirebaseConfigured){
            msgEl.style.color = 'orange';
            msgEl.textContent = '⚠️ Firebase غير مكون - تم الحفظ محلياً فقط. اضغط ⚙️ لإدخال إعدادات Firebase';
            openSettingsModal();
            return;
        }
        // حفظ في Realtime Database
        if(firebaseDB){
            await firebaseDB.ref('pharmacies/shifa_central/customers').set(customers);
            await firebaseDB.ref('pharmacies/shifa_central/lastUpdate').set(new Date().toISOString());
        }
        // حفظ أيضاً في Firestore إن وجد
        if(window.firestoreDB){
            await window.firestoreDB.collection('pharmacies').doc('shifa_central').set({
                customers: customers,
                lastUpdate: new Date().toISOString(),
                totalDebt: customers.reduce((s,c)=> s + calcNew(c), 0)
            }, {merge:true});
        }
        msgEl.style.color = 'green';
        msgEl.textContent = '✅ تم الرفع إلى سيرفر جوجل Firebase بنجاح - ' + new Date().toLocaleTimeString('ar-EG');
        showToast('☁️ تم الرفع إلى جوجل بنجاح');
    }catch(e){
        msgEl.style.color = 'red';
        msgEl.textContent = '❌ فشل الرفع: ' + e.message;
        console.error(e);
    }
}

function downloadBackup(){
    const dataStr = JSON.stringify(customers, null, 2);
    const blob = new Blob([dataStr], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'shifa_backup_' + new Date().toISOString().slice(0,10) + '.json';
    a.click();
    URL.revokeObjectURL(url);
    showToast('📥 تم تحميل النسخة الاحتياطية');
}

async function restoreFromCloud(){
    const msgEl = document.getElementById('cloudMsg');
    msgEl.style.color = '#FF9800';
    msgEl.textContent = '⏳ جاري الاسترجاع من سيرفر جوجل...';
    try{
        if(!isFirebaseConfigured) initFirebase();
        if(!isFirebaseConfigured){
            // fallback to file picker
            const input = document.createElement('input');
            input.type='file'; input.accept='.json';
            input.onchange = e=>{
                const file = e.target.files[0]; if(!file) return;
                const reader = new FileReader();
                reader.onload = ev=>{
                    try{
                        const data = JSON.parse(ev.target.result);
                        if(Array.isArray(data)){ customers=data; saveLocal(); render(); showToast('✅ تم الاسترجاع من الملف'); msgEl.textContent='✅ تم الاسترجاع من الملف'; }
                    }catch(err){ alert('ملف غير صالح'); }
                }; reader.readAsText(file);
            }; input.click();
            msgEl.textContent = 'اختر ملف JSON للاسترجاع';
            return;
        }
        let fetched = null;
        if(firebaseDB){
            const snap = await firebaseDB.ref('pharmacies/shifa_central/customers').once('value');
            fetched = snap.val();
        }
        if(!fetched && window.firestoreDB){
            const doc = await window.firestoreDB.collection('pharmacies').doc('shifa_central').get();
            if(doc.exists){ fetched = doc.data().customers; }
        }
        if(fetched && Array.isArray(fetched)){
            customers = fetched;
            saveLocal();
            render();
            msgEl.style.color='green';
            msgEl.textContent='✅ تم الاسترجاع من سيرفر جوجل - ' + customers.length + ' عميل';
            showToast('✅ تم الاسترجاع من جوجل');
        }else{
            msgEl.style.color='orange';
            msgEl.textContent='⚠️ لا توجد بيانات في السحابة - سيتم استخدام الحفظ المحلي';
        }
    }catch(e){
        msgEl.style.color='red';
        msgEl.textContent='❌ فشل الاسترجاع: '+e.message;
    }
}

function calcNew(c){ return (parseFloat(c.balance)||0) + (parseFloat(c.debt)||0) - (parseFloat(c.paid)||0); }

function getFiltered(){
    let list = customers;
    const idQ = document.getElementById('searchId').value.trim();
    const nameQ = document.getElementById('searchName').value.trim();
    if(idQ) list = list.filter(c=> c.id.toString().includes(idQ));
    if(nameQ) list = list.filter(c=> c.name.includes(nameQ));
    if(showMovementOnly) list = list.filter(c=> (parseFloat(c.debt)||0)>0 || (parseFloat(c.paid)||0)>0);
    return list;
}

function render(){
    const list = getFiltered();
    const total = customers.reduce((s,c)=> s + calcNew(c), 0);
    document.getElementById('totalDebtBox').innerText = '💰 إجمالي الديون: ' + total.toLocaleString('ar-EG') + ' ريال';
    document.getElementById('stats').innerText = `📊 إجمالي: ${customers.length} | معروض: ${list.length} | 🔴 حركة اليوم: ${customers.filter(c=>c.debt>0||c.paid>0).length}`;

    let html = '<table><thead><tr><th>#</th><th>الاسم</th><th>الجوال</th><th>الرصيد الرئيسي</th><th>فاتورة(+)</th><th>سداد(-)</th><th>الرصيد الجديد</th><th>إجراءات</th></tr></thead><tbody>';
    list.forEach(c=>{
        const newBal = calcNew(c);
        html += `<tr class="compact-row">
            <td>${c.id}</td>
            <td><strong>${c.name}</strong></td>
            <td><input type="text" id="phone_${c.id}" value="${c.phone}" style="width:85px; font-size:11px;" onchange="updatePhone('${c.id}', this.value)"></td>
            <td><input type="number" id="balance_${c.id}" value="${c.balance}" step="any" style="width:65px; font-size:11px;" onchange="updateBalance('${c.id}', this.value)"></td>
            <td><input type="number" id="debt_${c.id}" value="${c.debt}" step="any" style="width:55px; font-size:11px;" onchange="updateDebt('${c.id}', this.value)"></td>
            <td><input type="number" id="paid_${c.id}" value="${c.paid}" step="any" style="width:55px; font-size:11px;" onchange="updatePaid('${c.id}', this.value)"></td>
            <td id="new_${c.id}" style="color:#2b8c5e; font-weight:bold; font-size:11px;">${newBal.toLocaleString()}</td>
            <td>
                <div class="action-buttons">
                    <button class="touch-btn" title="حفظ" onclick="saveRow('${c.id}')">💾</button>
                    <button class="btn-wa touch-btn" title="واتساب" onclick="openMessage('${c.id}')">📱</button>
                    <button class="btn-sms touch-btn" title="رسالة" onclick="openMessage('${c.id}')">✉️</button>
                    <button class="btn-danger touch-btn" title="حذف" onclick="deleteCustomer('${c.id}')">🗑️</button>
                </div>
            </td>
        </tr>`;
    });
    html += '</tbody></table>';
    document.getElementById('customersTable').innerHTML = html;
}

function updatePhone(id, v){ const c=customers.find(x=>x.id==id); if(c) c.phone=v; }
function updateBalance(id, v){ const c=customers.find(x=>x.id==id); if(c){ c.balance=parseFloat(v)||0; document.getElementById('new_'+id).innerText = calcNew(c).toLocaleString(); } }
function updateDebt(id, v){ const c=customers.find(x=>x.id==id); if(c){ c.debt=parseFloat(v)||0; document.getElementById('new_'+id).innerText = calcNew(c).toLocaleString(); } }
function updatePaid(id, v){ const c=customers.find(x=>x.id==id); if(c){ c.paid=parseFloat(v)||0; document.getElementById('new_'+id).innerText = calcNew(c).toLocaleString(); } }
function saveRow(id){ saveLocal(); showToast('تم حفظ '+id); }

// ===== صيغة الرسالة المطلوبة =====
function buildMessage(c){
    const name = c.name;
    const newBal = calcNew(c);
    const debt = parseFloat(c.debt)||0;
    const paid = parseFloat(c.paid)||0;
    const pharmacy = 'صيدلية الشفاء المركزية';
    const phone = '774410166';

    // حسب طلبك:
    // إذا عليه فاتورة (debt >0) -> رسالة فاتورة فقط، بدون ذكر "تم استلام"
    // إذا أعطى مبلغ (paid >0) -> رسالة استلام فقط، بدون ذكر "تم تقييد مبلغ"

    if(paid > 0 && debt === 0){
        // حالة سداد
        return `السلام عليكم ${name}\nتم استلام مبلغ قدره ${paid.toLocaleString()} ريال\nمنكم في ${pharmacy}\nالرصيد المتبقي عليكم: ${newBal.toLocaleString()} ريال\nشكراً لتعاملكم معنا\nللاستفسار: ${phone}`;
    } else if(debt > 0 && paid === 0){
        // حالة فاتورة
        return `السلام عليكم ${name}\nنود إعلامكم أن عليكم فاتورة بمبلغ ${debt.toLocaleString()} ريال\nفي ${pharmacy}\nإجمالي الرصيد الحالي: ${newBal.toLocaleString()} ريال\nنرجو التكرم بالسداد في أقرب فرصة\nللاستفسار: ${phone}`;
    } else if(debt > 0 && paid > 0){
        // حالة مختلطة - نعطي الأولوية حسب ما تريد: نفصلها بوضوح بدون خلط العبارات
        // سنرسل رسالتين منفصلتين منطقياً في رسالة واحدة منظمة
        return `السلام عليكم ${name}\nتم استلام مبلغ قدره ${paid.toLocaleString()} ريال\nوتم تسجيل فاتورة جديدة بمبلغ ${debt.toLocaleString()} ريال\nفي ${pharmacy}\nالرصيد الحالي: ${newBal.toLocaleString()} ريال\nللاستفسار: ${phone}`;
    } else {
        // لا حركة - تذكير عام
        return `السلام عليكم ${name}\nنذكركم بأن رصيدكم الحالي في ${pharmacy} هو ${newBal.toLocaleString()} ريال\nللاستفسار: ${phone}`;
    }
}

function openMessage(id){
    const c = customers.find(x=>x.id==id);
    if(!c) return;
    currentMessageCustomer = c;
    currentMessageText = buildMessage(c);
    document.getElementById('modalMessage').innerText = currentMessageText;
    document.getElementById('messageModal').classList.add('active');
}

function closeMessageModal(){ document.getElementById('messageModal').classList.remove('active'); }
function sendWhatsAppCurrent(){
    if(!currentMessageCustomer) return;
    const phone = currentMessageCustomer.phone.replace(/[^0-9]/g,'');
    let waPhone = phone;
    if(waPhone.startsWith('7')) waPhone = '967' + waPhone;
    const url = `https://wa.me/${waPhone}?text=${encodeURIComponent(currentMessageText)}`;
    window.open(url,'_blank');
    // تصفير الحركة بعد الإرسال
    currentMessageCustomer.debt = 0;
    currentMessageCustomer.paid = 0;
    saveLocal();
    closeMessageModal();
}
function sendSmsCurrent(){
    if(!currentMessageCustomer) return;
    const phone = currentMessageCustomer.phone;
    const url = `sms:${phone}?body=${encodeURIComponent(currentMessageText)}`;
    window.open(url,'_blank');
    currentMessageCustomer.debt = 0;
    currentMessageCustomer.paid = 0;
    saveLocal();
    closeMessageModal();
}

function openAddModal(){ document.getElementById('addCustomerModal').classList.add('active'); }
function closeAddModal(){ document.getElementById('addCustomerModal').classList.remove('active'); }
function addCustomer(){
    const name = document.getElementById('newCustomerName').value.trim();
    const phone = document.getElementById('newCustomerPhone').value.trim();
    if(!name){ alert('أدخل اسم العميل'); return; }
    const newId = Date.now().toString();
    customers.push({id:newId, name:name, phone:phone, balance:0, debt:0, paid:0});
    document.getElementById('newCustomerName').value='';
    document.getElementById('newCustomerPhone').value='';
    closeAddModal();
    saveLocal();
}

function deleteCustomer(id){
    if(!confirm('هل أنت متأكد من حذف العميل؟')) return;
    customers = customers.filter(c=>c.id!=id);
    saveLocal();
}

function doSearch(){ render(); }
function clearSearch(){ document.getElementById('searchId').value=''; document.getElementById('searchName').value=''; render(); }
function showAll(){ showMovementOnly=false; document.getElementById('showAllBtn').style.opacity='1'; document.getElementById('showMovementBtn').style.opacity='0.6'; render(); }
function showMovement(){ showMovementOnly=true; document.getElementById('showAllBtn').style.opacity='0.6'; document.getElementById('showMovementBtn').style.opacity='1'; render(); }

function exportExcel(){
    const data = customers.map(c=>({
        'رقم العميل': c.id,
        'الاسم': c.name,
        'الجوال': c.phone,
        'الرصيد الرئيسي': c.balance,
        'فاتورة': c.debt,
        'سداد': c.paid,
        'الرصيد الجديد': calcNew(c)
    }));
    const ws = XLSX.utils.json_to_sheet(data);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'العملاء');
    XLSX.writeFile(wb, 'صيدلية_الشفاء_المركزية_'+ new Date().toISOString().slice(0,10)+'.xlsx');
}

