            <input type="text" id="cfg_authDomain" placeholder="authDomain" style="flex:1; min-width:120px; padding:6px; border:1px solid #ddd; border-radius:6px;">
        </div>
        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:6px;">
            <input type="text" id="cfg_databaseURL" placeholder="databaseURL" style="flex:1; min-width:120px; padding:6px; border:1px solid #ddd; border-radius:6px;">
            <input type="text" id="cfg_projectId" placeholder="projectId" style="flex:1; min-width:120px; padding:6px; border:1px solid #ddd; border-radius:6px;">
        </div>
        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:6px;">
            <input type="text" id="cfg_storageBucket" placeholder="storageBucket" style="flex:1; padding:6px; border:1px solid #ddd; border-radius:6px;">
            <input type="text" id="cfg_messagingSenderId" placeholder="messagingSenderId" style="flex:1; padding:6px; border:1px solid #ddd; border-radius:6px;">
        </div>
        <input type="text" id="cfg_appId" placeholder="appId" style="width:100%; margin-top:6px; padding:6px; border:1px solid #ddd; border-radius:6px;">
        <div style="display:flex; gap:8px; justify-content:center; margin-top:12px;">
            <button class="touch-btn" onclick="saveFirebaseConfig()" style="background:#2b8c5e;">💾 حفظ الإعدادات</button>
            <button class="touch-btn" onclick="testFirebaseConfig()" style="background:#1E88E5;">🧪 اختبار الاتصال</button>
            <button class="touch-btn" style="background:#999;" onclick="closeSettingsModal()">❌ إغلاق</button>
        </div>
        <div id="settingsMsg" style="margin-top:8px; font-size:12px; text-align:center;"></div>
    </div>
</div>

<div class="modal-overlay" id="addCustomerModal">
    <div class="modal">
        <h3>➕ إضافة عميل جديد</h3>
        <input type="text" id="newCustomerName" placeholder="📝 اسم العميل" style="width:100%; padding:10px; margin-bottom:10px; border:1px solid #ddd; border-radius:8px;">
        <input type="text" id="newCustomerPhone" placeholder="📞 رقم الهاتف" style="width:100%; padding:10px; margin-bottom:15px; border:1px solid #ddd; border-radius:8px;">
        <div style="display:flex; gap:8px; justify-content:center;">
            <button class="touch-btn" onclick="addCustomer()">✅ إضافة</button>
            <button class="touch-btn" style="background:#999;" onclick="closeAddModal()">❌ إلغاء</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="messageModal">
    <div class="modal">
        <h3>📨 إرسال إشعار</h3>
        <p id="modalMessage" style="white-space:pre-wrap; line-height:1.6; background:#f9f9f9; padding:10px; border-radius:8px;"></p>
        <div style="display:flex; gap:8px; justify-content:center; margin-top:12px;">
            <button class="touch-btn btn-wa" onclick="sendWhatsAppCurrent()">📱 واتساب</button>
            <button class="touch-btn btn-sms" onclick="sendSmsCurrent()">✉️ رسالة</button>
            <button class="touch-btn" style="background:#999;" onclick="closeMessageModal()">❌ إغلاق</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="sendAllModal">
    <div class="modal">
        <h3>📱 إرسال رسائل واتساب للكل</h3>
        <p>سيتم إرسال رسائل تذكير لجميع العملاء الذين لديهم ديون</p>
        <div style="display:flex; gap:8px; justify-content:center;">
            <button class="touch-btn btn-wa" onclick="sendAll()">📱 بدء الإرسال</button>
            <button class="touch-btn" style="background:#999;" onclick="closeSendAllModal()">❌ إلغاء</button>
        </div>
    </div>
</div>

