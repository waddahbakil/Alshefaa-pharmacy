let customers = [];
let currentMessageCustomer = null;
let currentMessageText = "";
let showMovementOnly = false;

function loadCustomers(){
    const saved = localStorage.getItem('shifa_customers_v2');
    if(saved){
        try {
            customers = JSON.parse(saved);
            console.log('loaded from local');
        } catch(e){ customers = initialCustomers; }
    } else {
        customers = initialCustomers;
    }
    // ensure numbers
    customers.forEach(c=>{
        c.balance = parseFloat(c.balance)||0;
        c.debt = parseFloat(c.debt)||0;
        c.paid = parseFloat(c.paid)||0;
    });
}

function saveLocal(){
    localStorage.setItem('shifa_customers_v2', JSON.stringify(customers));
    localStorage.setItem('shifa_last_save', new Date().toISOString());
    document.getElementById('syncStatus').innerHTML = '✅ تم الحفظ المحلي بنجاح - ' + new Date().toLocaleTimeString('ar-EG');
    document.getElementById('syncStatus').style.background = '#e8f5e9';
    showToast('✅ تم الحفظ داخل الملف (LocalStorage)');
    render();
}

